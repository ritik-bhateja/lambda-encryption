          "host": [
            "{{api_url}}"
          ],
          "path": [
            "employee"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_value\": \"{{happy_value}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('rejected with CRY409', () => pm.expect(b.response_error_code).to.eql('CRY409'));",
              "pm.test('error readable, nothing leaked', () => {",
              "  pm.expect(b.encrypted).to.be.false;",
              "  pm.expect(b).to.not.have.property('response_key');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04. Label from A on data from B (CRY422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{api_url}}/employee",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "employee"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_value\": \"{{spliced_value}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({",
              "  url: pm.variables.get('dev_url') + '/dev/seal', method: 'POST',",
              "  header: { 'Content-Type': 'application/json',",
              "            'Authorization': 'Bearer ' + pm.variables.get('token') },",
              "  body: { mode: 'raw', raw: JSON.stringify({ path: '/employee', method: 'POST', payload: {\"employee_code\": \"EMP001\"} }) }",
              "}, (err, res) => {",
              "  if (err || res.code !== 200) { console.error('dev/seal failed', err || res.code); return; }",
              "  const v = res.json().request_value;",
              "  pm.collectionVariables.set('a_value', v);",
              "  pm.sendRequest({",
              "    url: pm.variables.get('dev_url') + '/dev/seal', method: 'POST',",
              "    header: { 'Content-Type': 'application/json',",
              "              'Authorization': 'Bearer ' + pm.variables.get('token') },",
              "    body: { mode: 'raw', raw: JSON.stringify({ path: '/employee', method: 'POST', payload: {\"employee_code\": \"EMP002\"} }) }",
              "  }, (err, res) => {",
              "    if (err || res.code !== 200) { console.error('dev/seal failed', err || res.code); return; }",
              "    const v = res.json().request_value;",
              "    pm.collectionVariables.set('b_value', v);",
              "    const a = pm.collectionVariables.get('a_value').split('.');",
              "    const b = v.split('.');",
              "    pm.collectionVariables.set('spliced_value', [a[0], b[1], b[2], b[3]].join('.'));",
              "  });",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('rejected with CRY422', () => pm.expect(b.response_error_code).to.eql('CRY422'));",
              "pm.test('error readable, nothing leaked', () => {",
              "  pm.expect(b.encrypted).to.be.false;",
              "  pm.expect(b).to.not.have.property('response_key');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05. Edit one second in the label (CRY422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{api_url}}/employee",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "employee"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_value\": \"{{edited_value}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({",
              "  url: pm.variables.get('dev_url') + '/dev/seal', method: 'POST',",
              "  header: { 'Content-Type': 'application/json',",
              "            'Authorization': 'Bearer ' + pm.variables.get('token') },",
              "  body: { mode: 'raw', raw: JSON.stringify({ path: '/employee', method: 'POST', payload: {\"employee_code\": \"EMP001\"} }) }",
              "}, (err, res) => {",
              "  if (err || res.code !== 200) { console.error('dev/seal failed', err || res.code); return; }",
              "  const v = res.json().request_value;",
              "  pm.collectionVariables.set('e_value', v);",
              "  const p = v.split('.');",
              "  const s = p[0].replace(/-/g, '+').replace(/_/g, '/');",
              "  const label = JSON.parse(atob(s + '='.repeat((4 - s.length % 4) % 4)));",
              "  label.iat = label.iat - 1;",
              "  p[0] = btoa(JSON.stringify(label)).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
              "  pm.collectionVariables.set('edited_value', p.join('.'));",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('rejected with CRY422', () => pm.expect(b.response_error_code).to.eql('CRY422'));",
              "pm.test('error readable, nothing leaked', () => {",
              "  pm.expect(b.encrypted).to.be.false;",
              "  pm.expect(b).to.not.have.property('response_key');",
              "});"
            ]
          }
        }
      ]
    },
