    {
      "name": "05. Label from A on data from B (CRY422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{host}}/prod/employee",
          "host": [
            "{{host}}"
          ],
          "path": [
            "prod",
            "employee"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_value\": \"{{spliced_value}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({",
              "  url: pm.variables.get('host') + '/dev/seal', method: 'POST',",
              "  header: { 'Content-Type': 'application/json',",
              "            'Authorization': 'Bearer ' + pm.collectionVariables.get('token') },",
              "  body: { mode: 'raw', raw: JSON.stringify({ path: '/employee', method: 'POST', payload: {\"employee_code\": \"EMP001\"} }) }",
              "}, (err, res) => {",
              "  const v = res.json().request_value;",
              "  pm.collectionVariables.set('a_value', v);",
              "  // only after A exists, build B, then splice A's label onto B's data",
              "  pm.sendRequest({",
              "    url: pm.variables.get('host') + '/dev/seal', method: 'POST',",
              "    header: { 'Content-Type': 'application/json',",
              "              'Authorization': 'Bearer ' + pm.collectionVariables.get('token') },",
              "    body: { mode: 'raw', raw: JSON.stringify({ path: '/employee', method: 'POST', payload: {\"employee_code\": \"EMP002\"} }) }",
              "  }, (err, res) => {",
              "    const v = res.json().request_value;",
              "    pm.collectionVariables.set('b_value', v);",
              "    const a = pm.collectionVariables.get('a_value').split('.');",
              "    const b = v.split('.');",
              "    pm.collectionVariables.set('spliced_value', [a[0], b[1], b[2], b[3]].join('.'));",
              "  });",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test('rejected with CRY422', () => pm.expect(b.response_error_code).to.eql('CRY422'));",
              "pm.test('error readable, nothing leaked', () => {",
              "  pm.expect(b.encrypted).to.be.false;",
              "  pm.expect(b).to.not.have.property('response_key');",
              "  pm.expect(b.response_data).to.eql({});",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06. Edit one second in the label (CRY422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
