## API Gateway integration request mapping template
## Content-Type: application/json
##
## This is your existing template plus the four crypto context values.
## Everything above the "crypto profile" block is unchanged, so adding
## encryption does not alter the event shape your handlers already expect.
{
  "body-json" : $input.json('$'),

  "params" : {
    "path"        : { #foreach($p in $input.params().path.keySet())"$p" : "$util.escapeJavaScript($input.params().path.get($p))"#if($foreach.hasNext),#end#end },
    "querystring" : { #foreach($q in $input.params().querystring.keySet())"$q" : "$util.escapeJavaScript($input.params().querystring.get($q))"#if($foreach.hasNext),#end#end },
    "header"      : { #foreach($h in $input.params().header.keySet())"$h" : "$util.escapeJavaScript($input.params().header.get($h))"#if($foreach.hasNext),#end#end }
  },

  "context" : {
    "request-id"       : "$context.requestId",
    "resource-path"    : "$context.resourcePath",
    "stage"            : "$context.stage",
    "http-method"      : "$context.httpMethod",
    "source-ip"        : "$context.identity.sourceIp",

    ## existing authorization context
    "x-Hasura-Role"    : "$context.authorizer.role_id",
    "X-Hasura-User-Id" : "$context.authorizer.allowed_ids",

    ## crypto profile, new
    "client-ref"       : "$context.authorizer.client_ref",
    "crypto-mode"      : "$context.authorizer.crypto_mode",
    "key-version"      : "$context.authorizer.key_version",
    "epoch-seconds"    : "$context.authorizer.epoch_seconds",
    "source-ips"       : "$context.authorizer.source_ips"
  }
}
